 drivers/staging/t2bce/t2bce_ave/video.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/staging/t2bce/t2bce_ave/video.c b/drivers/staging/t2bce/t2bce_ave/video.c
index a9098945f4e8..1b62dba8c520 100644

From: Andre Eikmeyer <dev@deq.rocks>
Subject: [PATCH] wifi: brcmfmac: add an AWDL interface for the Apple firmware

The Apple firmware for the BCM4355, BCM4364 and BCM4377 runs AWDL itself
once the host creates an interface of type 2 with interface_create and
configures it through the awdl_* iovars. The interface is created as
macOS does it: flags 0x1a (MAC address, if_index and BSSID given),
if_index 2 and the AWDL BSSID 00:25:00:ff:94:73. Like macOS, iovars for
it are plain iovars on its interface index, and the host sends it no
multicast list and no MAC address. The firmware event mask is extended
before the interface is created. macOS keeps election,
synchronization, channel sequence and services in the host and only
programs the firmware.

Add the parts user space cannot do on its own:

- a generic netlink family "brcmf_awdl" (CAP_NET_ADMIN) with UP and DOWN
  for the AWDL interface, IOVAR_SET and IOVAR_GET on it or on the primary
  interface, and a multicast group "events" with the firmware events of
  the AWDL interface (received action frames 0x4b, AWDL events 0x60 to
  0x62, 0x96, 0x98). These events no longer reach the cfg80211 handlers,
  the interface has no vif.
- the network device awdl0 on the data path of that interface. The
  firmware passes AWDL data frames as 802.3 frames with LLC/SNAP
  aa aa 03 00 17 f2 08 00 and a data header 03 04, sequence, 00 00,
  ethertype. awdl0 unwraps received frames and wraps sent ones.

DOWN and a PM notifier before suspend and hibernation share one path: it
sets awdl to 0, puts back the event mask of the primary interface as it
was before UP and removes the interface, while the firmware still takes
commands. User space creates the interface again after resume.

Signed-off-by: Andre Eikmeyer <dev@deq.rocks>
---
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/awdl.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/awdl.c
@@ -0,0 +1,715 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * AWDL interface for the Apple firmware of the BCM4355, BCM4364 and BCM4377.
+ *
+ * The firmware runs AWDL itself once the host configures it through the
+ * awdl_* iovars on an interface created with interface_create (iftype 2).
+ * This file only provides what user space cannot do on its own:
+ *
+ * - a generic netlink family "brcmf_awdl" to create and remove the AWDL
+ *   interface, to set and get iovars on it or on the primary interface, and
+ *   a multicast group "events" carrying the firmware events of the AWDL
+ *   interface (received action frames, AWDL role and state events)
+ * - the network device awdl0 on the data path of the AWDL interface. The
+ *   firmware passes AWDL data frames as 802.3 frames with an LLC/SNAP header
+ *   (aa aa 03, OUI 00 17 f2, 08 00) and a data header (03 04, sequence,
+ *   00 00, ethertype). awdl0 unwraps received frames and wraps sent ones,
+ *   so the stack sees plain Ethernet.
+ *
+ * Election, synchronization, channel sequence, peers and services are left
+ * to user space, as macOS leaves them to IO80211Family and wifip2pd.
+ *
+ * Before suspend and hibernation every AWDL interface is removed again, with
+ * the firmware event mask of the primary interface as it was before. User
+ * space creates it anew after resume.
+ */
+
+#include <linux/etherdevice.h>
+#include <linux/netdevice.h>
+#include <linux/rtnetlink.h>
+#include <linux/suspend.h>
+#include <linux/unaligned.h>
+#include <net/genetlink.h>
+#include <brcmu_utils.h>
+
+#include "core.h"
+#include "debug.h"
+#include "fwil.h"
+#include "fweh.h"
+#include "awdl.h"
+
+#define BRCMF_AWDL_IFTYPE		2
+/*
+ * interface_create flags as macOS sets them for AWDL: use the given MAC
+ * address (0x2), if_index (0x8) and BSSID (0x10)
+ */
+#define BRCMF_AWDL_IF_FLAGS		0x1a
+#define BRCMF_AWDL_IF_INDEX		2
+#define BRCMF_AWDL_IF_WAIT_MS		2000
+#define BRCMF_AWDL_HDR_LEN		16
+#define BRCMF_AWDL_GET_MAX		BRCMF_DCMD_MAXLEN
+
+/* wl_interface_create_v3 */
+struct brcmf_awdl_if_create {
+	__le16 ver;
+	__le16 len;
+	__le16 fixed_len;
+	u8 iftype;
+	u8 wlc_index;
+	__le32 flags;
+	u8 mac_addr[ETH_ALEN];
+	u8 bssid[ETH_ALEN];
+	u8 if_index;
+	u8 pad[3];
+} __packed;
+
+/* The BSSID of all AWDL frames */
+static const u8 brcmf_awdl_bssid[ETH_ALEN] = {
+	0x00, 0x25, 0x00, 0xff, 0x94, 0x73,
+};
+
+/* LLC/SNAP with the Apple OUI and the start of the AWDL data header */
+static const u8 brcmf_awdl_llc[10] = {
+	0xaa, 0xaa, 0x03, 0x00, 0x17, 0xf2, 0x08, 0x00, 0x03, 0x04,
+};
+
+/* Firmware events of the AWDL interface passed to user space */
+static const u32 brcmf_awdl_events[] = {
+	0x4b,	/* action frame received */
+	0x60, 0x61, 0x62,	/* AWDL availability window, role, AWDL events */
+	0x96, 0x98,	/* AWDL statistics and SDB state */
+};
+
+struct brcmf_awdl {
+	struct brcmf_pub *drvr;
+	struct brcmf_if *ifp;
+	int primary_ifindex;
+	u16 tx_seq;
+	struct packet_type ptype;
+	/* event_msgs of the primary interface before AWDL was added */
+	u8 *saved_mask;
+	u32 mask_len;
+	struct list_head list;
+	struct rcu_head rcu;
+};
+
+enum brcmf_awdl_attr {
+	BRCMF_AWDL_ATTR_UNSPEC,
+	BRCMF_AWDL_ATTR_IFINDEX,	/* u32, primary interface of the chip */
+	BRCMF_AWDL_ATTR_MAC,		/* 6 bytes, address of the AWDL interface */
+	BRCMF_AWDL_ATTR_NAME,		/* string, iovar name */
+	BRCMF_AWDL_ATTR_DATA,		/* binary, iovar data or event data */
+	BRCMF_AWDL_ATTR_LEN,		/* u32, iovar get length */
+	BRCMF_AWDL_ATTR_PRIMARY,	/* flag, iovar on the primary interface */
+	BRCMF_AWDL_ATTR_AWDL_IFINDEX,	/* u32, ifindex of awdl0 */
+	BRCMF_AWDL_ATTR_EVENT,		/* u32, firmware event code */
+	BRCMF_AWDL_ATTR_STATUS,		/* u32 */
+	BRCMF_AWDL_ATTR_REASON,		/* u32 */
+	BRCMF_AWDL_ATTR_ADDR,		/* 6 bytes, event address */
+	BRCMF_AWDL_ATTR_FWERR,		/* s32, firmware error of an iovar */
+	__BRCMF_AWDL_ATTR_MAX,
+};
+#define BRCMF_AWDL_ATTR_MAX (__BRCMF_AWDL_ATTR_MAX - 1)
+
+enum brcmf_awdl_cmd {
+	BRCMF_AWDL_CMD_UNSPEC,
+	BRCMF_AWDL_CMD_UP,
+	BRCMF_AWDL_CMD_DOWN,
+	BRCMF_AWDL_CMD_IOVAR_SET,
+	BRCMF_AWDL_CMD_IOVAR_GET,
+	BRCMF_AWDL_CMD_EVENT,
+};
+
+static DEFINE_MUTEX(brcmf_awdl_mutex);
+/* Active AWDL interfaces of all devices, under brcmf_awdl_mutex */
+static LIST_HEAD(brcmf_awdl_list);
+/*
+ * awdl0 keeps these until it is unregistered, which may happen after the
+ * brcmf_awdl state is gone. The brcmfmac ops are the same for every device.
+ */
+static struct net_device_ops brcmf_awdl_netdev_ops;
+static netdev_tx_t (*brcmf_awdl_brcmf_xmit)(struct sk_buff *skb,
+					    struct net_device *ndev);
+static struct genl_family brcmf_awdl_family;
+
+static const struct nla_policy brcmf_awdl_policy[BRCMF_AWDL_ATTR_MAX + 1] = {
+	[BRCMF_AWDL_ATTR_IFINDEX] = { .type = NLA_U32 },
+	[BRCMF_AWDL_ATTR_MAC] = NLA_POLICY_EXACT_LEN(ETH_ALEN),
+	[BRCMF_AWDL_ATTR_NAME] = { .type = NLA_NUL_STRING, .len = 63 },
+	[BRCMF_AWDL_ATTR_DATA] = { .type = NLA_BINARY,
+				   .len = BRCMF_DCMD_MAXLEN },
+	[BRCMF_AWDL_ATTR_LEN] = { .type = NLA_U32 },
+	[BRCMF_AWDL_ATTR_PRIMARY] = { .type = NLA_FLAG },
+};
+
+static const struct genl_multicast_group brcmf_awdl_mcgrps[] = {
+	{ .name = "events", },
+};
+
+static netdev_tx_t brcmf_awdl_xmit(struct sk_buff *skb, struct net_device *ndev)
+{
+	struct brcmf_if *ifp = netdev_priv(ndev);
+	struct brcmf_awdl *awdl = rcu_dereference_bh(ifp->drvr->awdl);
+
+	/* Called with rcu_read_lock_bh() held by the stack */
+	__be16 proto;
+	u8 *p;
+
+	if (!awdl || skb->len < ETH_HLEN ||
+	    skb_cow_head(skb, BRCMF_AWDL_HDR_LEN)) {
+		dev_kfree_skb_any(skb);
+		ndev->stats.tx_dropped++;
+		return NETDEV_TX_OK;
+	}
+	proto = eth_hdr(skb)->h_proto;
+	p = skb_push(skb, BRCMF_AWDL_HDR_LEN);
+	memmove(p, p + BRCMF_AWDL_HDR_LEN, 2 * ETH_ALEN);
+	put_unaligned_be16(skb->len - ETH_HLEN, p + 12);
+	memcpy(p + 14, brcmf_awdl_llc, sizeof(brcmf_awdl_llc));
+	put_unaligned_le16(awdl->tx_seq++, p + 24);
+	put_unaligned_le16(0, p + 26);
+	memcpy(p + 28, &proto, sizeof(proto));
+	skb_reset_mac_header(skb);
+	return brcmf_awdl_brcmf_xmit(skb, ndev);
+}
+
+/* 802.2 frames on awdl0: strip the AWDL data header and deliver again */
+static int brcmf_awdl_rcv(struct sk_buff *skb, struct net_device *ndev,
+			  struct packet_type *pt, struct net_device *orig)
+{
+	skb = skb_share_check(skb, GFP_ATOMIC);
+	if (!skb)
+		return NET_RX_DROP;
+	if (!pskb_may_pull(skb, BRCMF_AWDL_HDR_LEN) ||
+	    memcmp(skb->data, brcmf_awdl_llc, sizeof(brcmf_awdl_llc))) {
+		kfree_skb(skb);
+		return NET_RX_DROP;
+	}
+	skb->protocol = *(__be16 *)(skb->data + 14);
+	skb_pull(skb, BRCMF_AWDL_HDR_LEN);
+	skb_reset_network_header(skb);
+	skb_reset_transport_header(skb);
+	return netif_rx(skb);
+}
+
+static int brcmf_awdl_open(struct net_device *ndev)
+{
+	netif_carrier_on(ndev);
+	netif_start_queue(ndev);
+	return 0;
+}
+
+static void brcmf_awdl_set_rx_mode(struct net_device *ndev)
+{
+}
+
+static int brcmf_awdl_stop(struct net_device *ndev)
+{
+	netif_stop_queue(ndev);
+	netif_carrier_off(ndev);
+	return 0;
+}
+
+/* The primary interface of a brcmfmac device, with a reference */
+static struct brcmf_pub *brcmf_awdl_get_drvr(struct genl_info *info,
+					     struct net_device **ndevp)
+{
+	struct net_device *ndev;
+	struct brcmf_if *ifp;
+
+	if (!info->attrs[BRCMF_AWDL_ATTR_IFINDEX]) {
+		GENL_SET_ERR_MSG(info, "missing ifindex");
+		return NULL;
+	}
+	ndev = dev_get_by_index(genl_info_net(info),
+				nla_get_u32(info->attrs[BRCMF_AWDL_ATTR_IFINDEX]));
+	if (!ndev)
+		return NULL;
+	ifp = brcmf_netdev_primary_ifp(ndev);
+	if (!ifp) {
+		dev_put(ndev);
+		GENL_SET_ERR_MSG(info, "not a brcmfmac primary interface");
+		return NULL;
+	}
+	*ndevp = ndev;
+	return ifp->drvr;
+}
+
+/* Adds the AWDL events to event_msgs, keeps the previous mask in awdl */
+static void brcmf_awdl_events_enable(struct brcmf_awdl *awdl)
+{
+	struct brcmf_if *pri = brcmf_get_ifp(awdl->drvr, 0);
+	u32 len = awdl->drvr->fweh->event_mask_len;
+	u8 *mask;
+	int i;
+
+	mask = kzalloc(len, GFP_KERNEL);
+	if (!mask)
+		return;
+	if (brcmf_fil_iovar_data_get(pri, "event_msgs", mask, len)) {
+		kfree(mask);
+		return;
+	}
+	awdl->saved_mask = kmemdup(mask, len, GFP_KERNEL);
+	awdl->mask_len = awdl->saved_mask ? len : 0;
+	for (i = 0; i < ARRAY_SIZE(brcmf_awdl_events); i++)
+		if (brcmf_awdl_events[i] / 8 < len)
+			setbit(mask, brcmf_awdl_events[i]);
+	brcmf_fil_iovar_data_set(pri, "event_msgs", mask, len);
+	kfree(mask);
+}
+
+static void brcmf_awdl_events_restore(struct brcmf_awdl *awdl)
+{
+	struct brcmf_if *pri = brcmf_get_ifp(awdl->drvr, 0);
+
+	if (pri && awdl->saved_mask)
+		brcmf_fil_iovar_data_set(pri, "event_msgs", awdl->saved_mask,
+					 awdl->mask_len);
+}
+
+/* Undoes UP before the AWDL state was published */
+static void brcmf_awdl_free_unused(struct brcmf_awdl *awdl)
+{
+	brcmf_awdl_events_restore(awdl);
+	kfree(awdl->saved_mask);
+	kfree(awdl);
+}
+
+static struct brcmf_if *brcmf_awdl_wait_if(struct brcmf_pub *drvr,
+					   const u8 *mac)
+{
+	unsigned long end = jiffies + msecs_to_jiffies(BRCMF_AWDL_IF_WAIT_MS);
+	struct brcmf_if *ifp;
+	int i;
+
+	do {
+		for (i = 1; i < BRCMF_MAX_IFS; i++) {
+			ifp = drvr->iflist[i];
+			if (ifp && ifp->ndev && !ifp->vif &&
+			    ether_addr_equal(ifp->mac_addr, mac))
+				return ifp;
+		}
+		msleep(20);
+	} while (time_before(jiffies, end));
+	return NULL;
+}
+
+static int brcmf_awdl_attach_netdev(struct brcmf_awdl *awdl)
+{
+	struct net_device *ndev = awdl->ifp->ndev;
+	int err;
+
+	strscpy(ndev->name, "awdl%d", IFNAMSIZ);
+	err = brcmf_net_attach(awdl->ifp, false);
+	if (err)
+		return err;
+	if (!brcmf_awdl_brcmf_xmit) {
+		brcmf_awdl_netdev_ops = *ndev->netdev_ops;
+		brcmf_awdl_brcmf_xmit = brcmf_awdl_netdev_ops.ndo_start_xmit;
+		brcmf_awdl_netdev_ops.ndo_open = brcmf_awdl_open;
+		brcmf_awdl_netdev_ops.ndo_stop = brcmf_awdl_stop;
+		brcmf_awdl_netdev_ops.ndo_start_xmit = brcmf_awdl_xmit;
+		/* macOS sends no multicast list or MAC address to the AWDL
+		 * interface, the firmware filters AWDL traffic itself
+		 */
+		brcmf_awdl_netdev_ops.ndo_set_rx_mode = brcmf_awdl_set_rx_mode;
+		brcmf_awdl_netdev_ops.ndo_set_mac_address = NULL;
+	}
+	ndev->netdev_ops = &brcmf_awdl_netdev_ops;
+	/* No cfg80211 vif to free for this interface */
+	ndev->priv_destructor = NULL;
+	ndev->needed_headroom += BRCMF_AWDL_HDR_LEN;
+	awdl->ptype.type = cpu_to_be16(ETH_P_802_2);
+	awdl->ptype.func = brcmf_awdl_rcv;
+	awdl->ptype.dev = ndev;
+	dev_add_pack(&awdl->ptype);
+	return 0;
+}
+
+/* Stops the data path. The interface itself goes with interface_remove. */
+static void brcmf_awdl_release(struct brcmf_pub *drvr)
+{
+	struct brcmf_awdl *awdl = rcu_dereference_protected(drvr->awdl,
+				lockdep_is_held(&brcmf_awdl_mutex));
+
+	if (!awdl)
+		return;
+	RCU_INIT_POINTER(drvr->awdl, NULL);
+	list_del(&awdl->list);
+	kfree(awdl->saved_mask);
+	awdl->saved_mask = NULL;
+	if (awdl->ptype.dev)
+		dev_remove_pack(&awdl->ptype);
+	if (awdl->ifp && awdl->ifp->ndev) {
+		cancel_work_sync(&awdl->ifp->multicast_work);
+		cancel_work_sync(&awdl->ifp->ndoffload_work);
+	}
+	kfree_rcu(awdl, rcu);
+}
+
+static int brcmf_awdl_cmd_up(struct sk_buff *skb, struct genl_info *info)
+{
+	struct brcmf_awdl_if_create req = {};
+	struct net_device *pndev;
+	u8 mac[ETH_ALEN];
+	struct brcmf_awdl *awdl;
+	struct brcmf_pub *drvr;
+	struct brcmf_if *pri;
+	struct sk_buff *msg;
+	void *hdr;
+	int err;
+
+	if (!info->attrs[BRCMF_AWDL_ATTR_MAC])
+		return -EINVAL;
+	drvr = brcmf_awdl_get_drvr(info, &pndev);
+	if (!drvr)
+		return -ENODEV;
+
+	mutex_lock(&brcmf_awdl_mutex);
+	if (rcu_access_pointer(drvr->awdl)) {
+		err = -EBUSY;
+		goto out;
+	}
+	awdl = kzalloc_obj(*awdl);
+	if (!awdl) {
+		err = -ENOMEM;
+		goto out;
+	}
+	awdl->drvr = drvr;
+	awdl->primary_ifindex = pndev->ifindex;
+	/* While the firmware surely answers, before the interface exists */
+	brcmf_awdl_events_enable(awdl);
+
+	pri = brcmf_get_ifp(drvr, 0);
+	req.ver = cpu_to_le16(3);
+	req.len = cpu_to_le16(sizeof(req));
+	req.fixed_len = cpu_to_le16(sizeof(req));
+	req.iftype = BRCMF_AWDL_IFTYPE;
+	req.flags = cpu_to_le32(BRCMF_AWDL_IF_FLAGS);
+	req.if_index = BRCMF_AWDL_IF_INDEX;
+	memcpy(req.bssid, brcmf_awdl_bssid, ETH_ALEN);
+	nla_memcpy(mac, info->attrs[BRCMF_AWDL_ATTR_MAC], ETH_ALEN);
+	memcpy(req.mac_addr, mac, ETH_ALEN);
+	pri->fwil_fwerr = true;
+	err = brcmf_fil_iovar_data_get(pri, "interface_create", &req,
+				       sizeof(req));
+	pri->fwil_fwerr = false;
+	if (err) {
+		GENL_SET_ERR_MSG(info, "interface_create failed");
+		brcmf_awdl_free_unused(awdl);
+		err = err < 0 ? err : -EIO;
+		goto out;
+	}
+	/* The reply of interface_create overwrites req */
+	awdl->ifp = brcmf_awdl_wait_if(drvr, mac);
+	if (!awdl->ifp) {
+		GENL_SET_ERR_MSG(info, "no interface event for the AWDL interface");
+		brcmf_awdl_free_unused(awdl);
+		err = -ETIMEDOUT;
+		goto out;
+	}
+	err = brcmf_awdl_attach_netdev(awdl);
+	if (err) {
+		brcmf_awdl_free_unused(awdl);
+		goto out;
+	}
+	rcu_assign_pointer(drvr->awdl, awdl);
+	list_add(&awdl->list, &brcmf_awdl_list);
+	brcmf_dbg(INFO, "AWDL interface %s bsscfg %d ifidx %d\n",
+		  awdl->ifp->ndev->name, awdl->ifp->bsscfgidx,
+		  awdl->ifp->ifidx);
+
+	msg = genlmsg_new(NLMSG_DEFAULT_SIZE, GFP_KERNEL);
+	if (!msg) {
+		err = -ENOMEM;
+		goto out;
+	}
+	hdr = genlmsg_put_reply(msg, info, &brcmf_awdl_family, 0,
+				BRCMF_AWDL_CMD_UP);
+	if (!hdr ||
+	    nla_put_u32(msg, BRCMF_AWDL_ATTR_AWDL_IFINDEX,
+			awdl->ifp->ndev->ifindex)) {
+		nlmsg_free(msg);
+		err = -EMSGSIZE;
+		goto out;
+	}
+	genlmsg_end(msg, hdr);
+	err = genlmsg_reply(msg, info);
+out:
+	mutex_unlock(&brcmf_awdl_mutex);
+	dev_put(pndev);
+	return err;
+}
+
+/*
+ * Stops AWDL in the firmware, restores the event mask and removes the AWDL
+ * interface. Called with brcmf_awdl_mutex held.
+ */
+static int brcmf_awdl_remove(struct brcmf_pub *drvr)
+{
+	struct brcmf_awdl *awdl;
+	struct brcmf_if *ifp;
+	int bsscfgidx, err;
+	unsigned long end;
+	__le32 off = 0;
+
+	awdl = rcu_dereference_protected(drvr->awdl,
+					 lockdep_is_held(&brcmf_awdl_mutex));
+	if (!awdl)
+		return -ENOENT;
+	ifp = awdl->ifp;
+	bsscfgidx = ifp->bsscfgidx;
+	brcmf_fil_iovar_data_set(ifp, "awdl", &off, sizeof(off));
+	brcmf_awdl_events_restore(awdl);
+	brcmf_awdl_release(drvr);
+	ifp->fwil_fwerr = true;
+	err = brcmf_fil_iovar_data_set(ifp, "interface_remove", NULL, 0);
+	ifp->fwil_fwerr = false;
+	/* The IF event removes awdl0 and the interface */
+	end = jiffies + msecs_to_jiffies(BRCMF_AWDL_IF_WAIT_MS);
+	while (drvr->iflist[bsscfgidx] == ifp && time_before(jiffies, end))
+		msleep(20);
+	if (drvr->iflist[bsscfgidx] == ifp)
+		err = -ETIMEDOUT;
+	return err;
+}
+
+static int brcmf_awdl_cmd_down(struct sk_buff *skb, struct genl_info *info)
+{
+	struct net_device *pndev;
+	struct brcmf_pub *drvr;
+	int err;
+
+	drvr = brcmf_awdl_get_drvr(info, &pndev);
+	if (!drvr)
+		return -ENODEV;
+
+	mutex_lock(&brcmf_awdl_mutex);
+	err = brcmf_awdl_remove(drvr);
+	mutex_unlock(&brcmf_awdl_mutex);
+	dev_put(pndev);
+	return err;
+}
+
+static int brcmf_awdl_cmd_iovar(struct sk_buff *skb, struct genl_info *info)
+{
+	bool get = info->genlhdr->cmd == BRCMF_AWDL_CMD_IOVAR_GET;
+	struct net_device *pndev;
+	struct brcmf_awdl *awdl;
+	struct brcmf_pub *drvr;
+	struct brcmf_if *ifp;
+	struct sk_buff *msg;
+	char name[64];
+	u32 len = 0;
+	void *hdr;
+	u8 *buf;
+	s32 fwerr;
+	int err;
+
+	if (!info->attrs[BRCMF_AWDL_ATTR_NAME])
+		return -EINVAL;
+	nla_strscpy(name, info->attrs[BRCMF_AWDL_ATTR_NAME], sizeof(name));
+	if (info->attrs[BRCMF_AWDL_ATTR_DATA])
+		len = nla_len(info->attrs[BRCMF_AWDL_ATTR_DATA]);
+	if (get && info->attrs[BRCMF_AWDL_ATTR_LEN])
+		len = max(len, nla_get_u32(info->attrs[BRCMF_AWDL_ATTR_LEN]));
+	if (len > BRCMF_AWDL_GET_MAX)
+		return -EINVAL;
+	drvr = brcmf_awdl_get_drvr(info, &pndev);
+	if (!drvr)
+		return -ENODEV;
+
+	buf = kzalloc(max_t(u32, len, 4), GFP_KERNEL);
+	if (!buf) {
+		dev_put(pndev);
+		return -ENOMEM;
+	}
+	if (info->attrs[BRCMF_AWDL_ATTR_DATA])
+		nla_memcpy(buf, info->attrs[BRCMF_AWDL_ATTR_DATA], len);
+
+	mutex_lock(&brcmf_awdl_mutex);
+	if (nla_get_flag(info->attrs[BRCMF_AWDL_ATTR_PRIMARY])) {
+		ifp = brcmf_get_ifp(drvr, 0);
+	} else {
+		awdl = rcu_dereference_protected(drvr->awdl,
+					lockdep_is_held(&brcmf_awdl_mutex));
+		if (!awdl) {
+			err = -ENOENT;
+			goto out;
+		}
+		ifp = awdl->ifp;
+	}
+	/* Plain iovars on the interface index, as macOS addresses them */
+	ifp->fwil_fwerr = true;
+	fwerr = get ? brcmf_fil_iovar_data_get(ifp, name, buf, len) :
+		      brcmf_fil_iovar_data_set(ifp, name, buf, len);
+	ifp->fwil_fwerr = false;
+
+	msg = genlmsg_new(NLMSG_DEFAULT_SIZE + (get ? len : 0), GFP_KERNEL);
+	if (!msg) {
+		err = -ENOMEM;
+		goto out;
+	}
+	hdr = genlmsg_put_reply(msg, info, &brcmf_awdl_family, 0,
+				info->genlhdr->cmd);
+	if (!hdr || nla_put_s32(msg, BRCMF_AWDL_ATTR_FWERR, fwerr) ||
+	    (get && !fwerr && nla_put(msg, BRCMF_AWDL_ATTR_DATA, len, buf))) {
+		nlmsg_free(msg);
+		err = -EMSGSIZE;
+		goto out;
+	}
+	genlmsg_end(msg, hdr);
+	err = genlmsg_reply(msg, info);
+out:
+	mutex_unlock(&brcmf_awdl_mutex);
+	kfree(buf);
+	dev_put(pndev);
+	return err;
+}
+
+static const struct genl_small_ops brcmf_awdl_ops[] = {
+	{
+		.cmd = BRCMF_AWDL_CMD_UP,
+		.doit = brcmf_awdl_cmd_up,
+		.flags = GENL_ADMIN_PERM,
+	},
+	{
+		.cmd = BRCMF_AWDL_CMD_DOWN,
+		.doit = brcmf_awdl_cmd_down,
+		.flags = GENL_ADMIN_PERM,
+	},
+	{
+		.cmd = BRCMF_AWDL_CMD_IOVAR_SET,
+		.doit = brcmf_awdl_cmd_iovar,
+		.flags = GENL_ADMIN_PERM,
+	},
+	{
+		.cmd = BRCMF_AWDL_CMD_IOVAR_GET,
+		.doit = brcmf_awdl_cmd_iovar,
+		.flags = GENL_ADMIN_PERM,
+	},
+};
+
+static struct genl_family brcmf_awdl_family __ro_after_init = {
+	.name = "brcmf_awdl",
+	.version = 1,
+	.maxattr = BRCMF_AWDL_ATTR_MAX,
+	.policy = brcmf_awdl_policy,
+	.module = THIS_MODULE,
+	.small_ops = brcmf_awdl_ops,
+	.n_small_ops = ARRAY_SIZE(brcmf_awdl_ops),
+	.resv_start_op = BRCMF_AWDL_CMD_EVENT + 1,
+	.mcgrps = brcmf_awdl_mcgrps,
+	.n_mcgrps = ARRAY_SIZE(brcmf_awdl_mcgrps),
+};
+
+/*
+ * Called from brcmf_fweh_process_event for every firmware event, possibly
+ * in atomic context. Returns true for events of the AWDL interface, which
+ * go to user space only. The interface events of it still take the normal
+ * path, they add and remove the interface.
+ */
+bool brcmf_awdl_event(struct brcmf_pub *drvr, const struct brcmf_event *ev,
+		      u32 code, const void *data, u32 datalen, gfp_t gfp)
+{
+	struct brcmf_awdl *awdl;
+	struct sk_buff *msg;
+	bool own = false;
+	int ifindex = 0;
+	void *hdr;
+
+	rcu_read_lock();
+	awdl = rcu_dereference(drvr->awdl);
+	if (awdl && awdl->ifp && ev->msg.bsscfgidx == awdl->ifp->bsscfgidx &&
+	    code != BRCMF_E_IF) {
+		own = true;
+		ifindex = awdl->primary_ifindex;
+	}
+	rcu_read_unlock();
+	if (!own)
+		return false;
+	if (!genl_has_listeners(&brcmf_awdl_family, &init_net, 0))
+		return true;
+
+	msg = genlmsg_new(NLMSG_DEFAULT_SIZE + datalen, gfp);
+	if (!msg)
+		return true;
+	hdr = genlmsg_put(msg, 0, 0, &brcmf_awdl_family, 0,
+			  BRCMF_AWDL_CMD_EVENT);
+	if (!hdr ||
+	    nla_put_u32(msg, BRCMF_AWDL_ATTR_IFINDEX, ifindex) ||
+	    nla_put_u32(msg, BRCMF_AWDL_ATTR_EVENT, code) ||
+	    nla_put_u32(msg, BRCMF_AWDL_ATTR_STATUS,
+			get_unaligned_be32(&ev->msg.status)) ||
+	    nla_put_u32(msg, BRCMF_AWDL_ATTR_REASON,
+			get_unaligned_be32(&ev->msg.reason)) ||
+	    nla_put(msg, BRCMF_AWDL_ATTR_ADDR, ETH_ALEN, ev->msg.addr) ||
+	    nla_put(msg, BRCMF_AWDL_ATTR_DATA, datalen, data)) {
+		nlmsg_free(msg);
+		return true;
+	}
+	genlmsg_end(msg, hdr);
+	genlmsg_multicast(&brcmf_awdl_family, msg, 0, 0, gfp);
+	return true;
+}
+
+/* Called from brcmf_detach before the interfaces are removed */
+void brcmf_awdl_detach(struct brcmf_pub *drvr)
+{
+	mutex_lock(&brcmf_awdl_mutex);
+	brcmf_awdl_release(drvr);
+	mutex_unlock(&brcmf_awdl_mutex);
+}
+
+/*
+ * Removes every AWDL interface before the system suspends or hibernates,
+ * while the firmware still takes commands.
+ */
+static int brcmf_awdl_pm_notify(struct notifier_block *nb,
+				unsigned long action, void *data)
+{
+	struct brcmf_awdl *awdl;
+	int err;
+
+	if (action != PM_SUSPEND_PREPARE && action != PM_HIBERNATION_PREPARE)
+		return NOTIFY_DONE;
+
+	mutex_lock(&brcmf_awdl_mutex);
+	while ((awdl = list_first_entry_or_null(&brcmf_awdl_list,
+						struct brcmf_awdl, list))) {
+		struct brcmf_pub *drvr = awdl->drvr;
+
+		err = brcmf_awdl_remove(drvr);
+		if (err)
+			bphy_err(drvr, "AWDL removal before sleep failed: %d\n",
+				 err);
+		else
+			brcmf_dbg(INFO, "AWDL removed before sleep\n");
+	}
+	mutex_unlock(&brcmf_awdl_mutex);
+	return NOTIFY_OK;
+}
+
+static struct notifier_block brcmf_awdl_pm_nb = {
+	.notifier_call = brcmf_awdl_pm_notify,
+};
+
+int __init brcmf_awdl_init(void)
+{
+	int err;
+
+	err = genl_register_family(&brcmf_awdl_family);
+	if (err)
+		return err;
+	err = register_pm_notifier(&brcmf_awdl_pm_nb);
+	if (err)
+		genl_unregister_family(&brcmf_awdl_family);
+	return err;
+}
+
+void brcmf_awdl_exit(void)
+{
+	unregister_pm_notifier(&brcmf_awdl_pm_nb);
+	genl_unregister_family(&brcmf_awdl_family);
+}

From 4ef3ca24d007e4ab4ffa9a28b72540f19f437567 Mon Sep 17 00:00:00 2001
From: Atharva Tiwari <atharvatiwarilinuxdev@gmail.com>
Date: Mon, 26 Oct 2026 17:06:31 -0400
Subject: [PATCH v2] amdgpu: add support for 5K

This patch adds support for 5K in iMac20,1 and iMac20,2.

genlock taken from:
https://github.com/MarkPronkin/imac5k-universal-linux-patcher/blob/main/patches/genlock-fix.patch

The merged-output part was written with the help of an AI coding
assistant (Claude).

Co-developed: Ed Schofield <ed@aicharmers.com>
Signed-off-by: Ed Schofield <ed@aicharmers.com>

Signed-off-by: Atharva Tiwari <atharvatiwarilinuxdev@gmail.com>
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c |  31 +-
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 557 ++++++++++++++++++
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h |  24 +
 .../display/amdgpu_dm/amdgpu_dm_connector.c   |  69 ++-
 .../amd/display/amdgpu_dm/amdgpu_dm_plane.c   |   9 +-
 .../amd/display/amdgpu_dm/amdgpu_dm_quirks.c  |  29 +-
 .../gpu/drm/amd/display/dc/core/dc_resource.c |  10 +
 drivers/gpu/drm/amd/display/dc/dc.h           |  10 +
 .../amd/display/dc/hwss/dce110/dce110_hwseq.c |  37 +-
 .../amd/display/dc/hwss/dcn10/dcn10_hwseq.c   |   8 +-
 .../drm/amd/display/dc/link/link_detection.c  |  23 +
 .../gpu/drm/amd/display/dc/link/link_dpms.c   |  16 +
 .../display/dc/link/protocols/link_dp_phy.c   |   5 +
 .../dc/link/protocols/link_dp_training.c      |   9 +-
 14 files changed, 819 insertions(+), 18 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
index 890792a94..ab90bddf1 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
@@ -21,6 +21,7 @@
  *
  */
 
+#include <linux/dmi.h>
 #include <linux/firmware.h>
 #include <linux/kernfs.h>
 
@@ -3412,6 +3413,22 @@ static int amdgpu_discovery_set_ualink_ip_blocks(struct amdgpu_device *adev)
 	return 0;
 }
 
+static const struct dmi_system_id imac5k_table[] = {
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Apple Inc."),
+			DMI_MATCH(DMI_PRODUCT_NAME, "iMac20,1"),
+		},
+	},
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Apple Inc."),
+			DMI_MATCH(DMI_PRODUCT_NAME, "iMac20,2"),
+		},
+	},
+	{}
+};
+
 int amdgpu_discovery_set_ip_blocks(struct amdgpu_device *adev)
 {
 	int r;
@@ -4026,15 +4043,23 @@ int amdgpu_discovery_set_ip_blocks(struct amdgpu_device *adev)
 		}
 	}
 
+	if (unlikely(dmi_check_system(imac5k_table))) {
+		r = amdgpu_discovery_set_display_ip_blocks(adev);
+		if (r)
+			return r;
+	}
+
 	if (likely(adev->firmware.load_type == AMDGPU_FW_LOAD_PSP)) {
 		r = amdgpu_discovery_set_smu_ip_blocks(adev);
 		if (r)
 			return r;
 	}
 
-	r = amdgpu_discovery_set_display_ip_blocks(adev);
-	if (r)
-		return r;
+	if (likely(!dmi_check_system(imac5k_table))) {
+		r = amdgpu_discovery_set_display_ip_blocks(adev);
+		if (r)
+			return r;
+	}
 
 	r = amdgpu_discovery_set_gc_ip_blocks(adev);
 	if (r)
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 5b634ae07..adb79b2c4 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -639,6 +639,10 @@ static int amdgpu_dm_init(struct amdgpu_device *adev)
 	retrieve_dmi_info(&adev->dm);
 	if (adev->dm.edp0_on_dp1_quirk)
 		init_data.flags.support_edp0_on_dp1 = true;
+	if (adev->dm.imac5K_support)
+		init_data.flags.imac5K_support = true;
+	adev->dm.imac5k_merge = adev->dm.imac5K_support &&
+				adev->mode_info.num_crtc > 1;
 
 	if (adev->dm.bb_from_dmub)
 		init_data.bb_from_dmub = adev->dm.bb_from_dmub;
@@ -1967,6 +1971,11 @@ static int dm_resume(struct amdgpu_ip_block *ip_block)
 		dc_exit_ips_for_hw_access(dm->dc);
 		WARN_ON(!dc_commit_streams(dm->dc, &commit_params));
 
+		if (dm->dc->config.imac5K_using_5K) {
+			const u8 value = 1;
+
+			core_link_write_dpcd(dm->dc->links[0], 0x4F1, &value, 1);
+		}
 		dm_gpureset_commit_state(dm->cached_dc_state, dm);
 
 		dm_gpureset_toggle_interrupts(adev, dm->cached_dc_state, true);
@@ -3657,6 +3666,505 @@ static void remove_stream(struct amdgpu_device *adev,
 	acrtc->enabled = false;
 }
 
+bool amdgpu_dm_imac5k_merge_active(struct amdgpu_display_manager *dm)
+{
+	return dm->imac5k_merge && dm->imac5k_conn[0] && dm->imac5k_conn[1];
+}
+
+static struct drm_crtc *imac5k_companion_crtc(struct amdgpu_display_manager *dm)
+{
+	if (!amdgpu_dm_imac5k_merge_active(dm))
+		return NULL;
+
+	return drm_crtc_from_index(dm->ddev, dm->adev->mode_info.num_crtc - 1);
+}
+
+bool amdgpu_dm_imac5k_crtc_is_left(struct amdgpu_display_manager *dm,
+				   struct drm_crtc *crtc)
+{
+	struct drm_crtc *comp = imac5k_companion_crtc(dm);
+
+	if (!comp || !crtc || crtc == comp)
+		return false;
+
+	return crtc->state &&
+	       (crtc->state->connector_mask &
+		drm_connector_mask(&dm->imac5k_conn[0]->base));
+}
+
+bool amdgpu_dm_imac5k_is_right_connector(const struct drm_connector *connector)
+{
+	struct amdgpu_display_manager *dm = &drm_to_adev(connector->dev)->dm;
+
+	return amdgpu_dm_imac5k_merge_active(dm) &&
+	       connector == &dm->imac5k_conn[1]->base;
+}
+
+bool amdgpu_dm_imac5k_stream_is_tile(const struct dc_stream_state *stream)
+{
+	struct amdgpu_dm_connector *aconnector = stream->dm_stream_context;
+	struct amdgpu_display_manager *dm;
+
+	if (!aconnector)
+		return false;
+
+	dm = &drm_to_adev(aconnector->base.dev)->dm;
+
+	return amdgpu_dm_imac5k_merge_active(dm) &&
+	       (aconnector == dm->imac5k_conn[0] ||
+		aconnector == dm->imac5k_conn[1]);
+}
+
+const struct drm_connector *
+amdgpu_dm_imac5k_proxy_connector(const struct drm_connector *connector)
+{
+	if (amdgpu_dm_imac5k_is_right_connector(connector))
+		return &drm_to_adev(connector->dev)->dm.imac5k_conn[0]->base;
+
+	return connector;
+}
+
+int amdgpu_dm_imac5k_tile_origin(struct drm_crtc *crtc,
+				 struct drm_atomic_commit *state)
+{
+	struct drm_crtc_state *crtc_state;
+
+	if (!crtc || crtc != imac5k_companion_crtc(&drm_to_adev(crtc->dev)->dm))
+		return 0;
+
+	crtc_state = state ? drm_atomic_get_new_crtc_state(state, crtc) : NULL;
+	if (!crtc_state)
+		crtc_state = crtc->state;
+
+	return crtc_state->mode.hdisplay / 2;
+}
+
+void amdgpu_dm_imac5k_mode_to_tile(struct drm_display_mode *mode)
+{
+	mode->clock /= 2;
+	mode->hdisplay /= 2;
+	mode->hsync_start /= 2;
+	mode->hsync_end /= 2;
+	mode->htotal /= 2;
+	mode->hskew /= 2;
+
+	mode->crtc_clock /= 2;
+	mode->crtc_hdisplay /= 2;
+	mode->crtc_hblank_start /= 2;
+	mode->crtc_hblank_end /= 2;
+	mode->crtc_hsync_start /= 2;
+	mode->crtc_hsync_end /= 2;
+	mode->crtc_htotal /= 2;
+	mode->crtc_hskew /= 2;
+}
+
+static bool imac5k_mode_halvable(const struct drm_display_mode *mode)
+{
+	return !((mode->clock | mode->hdisplay | mode->hsync_start |
+		  mode->hsync_end | mode->htotal | mode->hskew) & 1);
+}
+
+bool amdgpu_dm_imac5k_merge_modes(struct drm_connector *connector)
+{
+	struct amdgpu_display_manager *dm = &drm_to_adev(connector->dev)->dm;
+	struct amdgpu_dm_connector *aconnector = to_amdgpu_dm_connector(connector);
+	struct drm_display_mode *mode, *tmp, *tile = NULL, *merged;
+
+	if (!amdgpu_dm_imac5k_merge_active(dm) ||
+	    aconnector != dm->imac5k_conn[0])
+		return false;
+
+	list_for_each_entry(mode, &connector->probed_modes, head) {
+		if (mode->hdisplay != IMAC5K_TILE_WIDTH ||
+		    mode->vdisplay != IMAC5K_TILE_HEIGHT)
+			continue;
+		if (!tile || (mode->type & DRM_MODE_TYPE_PREFERRED))
+			tile = mode;
+	}
+
+	if (!tile)
+		return false;
+
+	merged = drm_mode_duplicate(connector->dev, tile);
+	if (!merged)
+		return false;
+
+	merged->clock *= 2;
+	merged->hdisplay *= 2;
+	merged->hsync_start *= 2;
+	merged->hsync_end *= 2;
+	merged->htotal *= 2;
+	merged->hskew *= 2;
+	merged->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_set_name(merged);
+
+	list_for_each_entry_safe(mode, tmp, &connector->probed_modes, head) {
+		if (mode->hdisplay != IMAC5K_TILE_WIDTH ||
+		    mode->vdisplay != IMAC5K_TILE_HEIGHT)
+			continue;
+
+		list_del(&mode->head);
+		drm_mode_destroy(connector->dev, mode);
+		aconnector->num_modes--;
+	}
+
+	drm_mode_probed_add(connector, merged);
+	aconnector->num_modes++;
+
+	return true;
+}
+
+static int imac5k_copy_plane_state(struct drm_plane_state *dst,
+				   struct drm_plane_state *src,
+				   struct drm_crtc *crtc)
+{
+	struct dm_plane_state *ddst = to_dm_plane_state(dst);
+	struct dm_plane_state *dsrc = to_dm_plane_state(src);
+	bool blob_changed = false;
+	int ret;
+
+	if (!src->fb || !src->crtc) {
+		drm_atomic_set_fb_for_plane(dst, NULL);
+		return drm_atomic_set_crtc_for_plane(dst, NULL);
+	}
+
+	if (src->color_pipeline)
+		return -EINVAL;
+
+	ret = drm_atomic_set_crtc_for_plane(dst, crtc);
+	if (ret)
+		return ret;
+
+	drm_atomic_set_fb_for_plane(dst, src->fb);
+
+	dst->crtc_x = src->crtc_x;
+	dst->crtc_y = src->crtc_y;
+	dst->crtc_w = src->crtc_w;
+	dst->crtc_h = src->crtc_h;
+	dst->src_x = src->src_x;
+	dst->src_y = src->src_y;
+	dst->src_w = src->src_w;
+	dst->src_h = src->src_h;
+	dst->hotspot_x = src->hotspot_x;
+	dst->hotspot_y = src->hotspot_y;
+	dst->alpha = src->alpha;
+	dst->pixel_blend_mode = src->pixel_blend_mode;
+	dst->rotation = src->rotation;
+	dst->zpos = src->zpos;
+	dst->color_encoding = src->color_encoding;
+	dst->color_range = src->color_range;
+	dst->scaling_filter = src->scaling_filter;
+	dst->ignore_damage_clips = src->ignore_damage_clips;
+	drm_property_replace_blob(&dst->fb_damage_clips, src->fb_damage_clips);
+
+	if (src->fence && !dst->fence)
+		dst->fence = dma_fence_get(src->fence);
+
+	blob_changed |= drm_property_replace_blob(&ddst->degamma_lut, dsrc->degamma_lut);
+	blob_changed |= drm_property_replace_blob(&ddst->ctm, dsrc->ctm);
+	blob_changed |= drm_property_replace_blob(&ddst->shaper_lut, dsrc->shaper_lut);
+	blob_changed |= drm_property_replace_blob(&ddst->lut3d, dsrc->lut3d);
+	blob_changed |= drm_property_replace_blob(&ddst->blend_lut, dsrc->blend_lut);
+	ddst->degamma_tf = dsrc->degamma_tf;
+	ddst->shaper_tf = dsrc->shaper_tf;
+	ddst->blend_tf = dsrc->blend_tf;
+	ddst->hdr_mult = dsrc->hdr_mult;
+	dst->color_mgmt_changed = src->color_mgmt_changed || blob_changed;
+
+	return 0;
+}
+
+static int imac5k_disable_plane(struct drm_atomic_commit *state,
+				struct drm_plane *plane)
+{
+	struct drm_plane_state *ps = drm_atomic_get_plane_state(state, plane);
+
+	if (IS_ERR(ps))
+		return PTR_ERR(ps);
+
+	if (!ps->crtc && !ps->fb)
+		return 0;
+
+	drm_atomic_set_fb_for_plane(ps, NULL);
+	return drm_atomic_set_crtc_for_plane(ps, NULL);
+}
+
+static int imac5k_disable_companion(struct drm_atomic_commit *state,
+				    struct drm_crtc *comp,
+				    struct drm_connector_state *right_state)
+{
+	struct drm_crtc_state *comp_state;
+	int ret;
+
+	comp_state = drm_atomic_get_crtc_state(state, comp);
+	if (IS_ERR(comp_state))
+		return PTR_ERR(comp_state);
+
+	if (!comp_state->enable && !comp_state->active && !right_state->crtc &&
+	    !comp->primary->state->crtc)
+		return 0;
+
+	if (right_state->crtc) {
+		ret = drm_atomic_set_crtc_for_connector(right_state, NULL);
+		if (ret)
+			return ret;
+	}
+
+	ret = imac5k_disable_plane(state, comp->primary);
+	if (ret)
+		return ret;
+
+	ret = imac5k_disable_plane(state, comp->cursor);
+	if (ret)
+		return ret;
+
+	ret = drm_atomic_set_mode_for_crtc(comp_state, NULL);
+	if (ret)
+		return ret;
+
+	comp_state->active = false;
+
+	return 0;
+}
+
+static int imac5k_mirror_crtc(struct drm_crtc_state *dst_state,
+			      struct drm_crtc_state *src_state)
+{
+	bool changed = false;
+	int ret;
+
+	ret = drm_atomic_set_mode_for_crtc(dst_state, &src_state->mode);
+	if (ret)
+		return ret;
+
+	dst_state->active = src_state->active;
+	dst_state->target_vblank = src_state->target_vblank;
+	dst_state->async_flip = src_state->async_flip;
+	dst_state->background_color = src_state->background_color;
+	dst_state->scaling_filter = src_state->scaling_filter;
+	dst_state->sharpness_strength = src_state->sharpness_strength;
+	dst_state->vrr_enabled = false;
+
+	changed |= drm_property_replace_blob(&dst_state->degamma_lut, src_state->degamma_lut);
+	changed |= drm_property_replace_blob(&dst_state->ctm, src_state->ctm);
+	changed |= drm_property_replace_blob(&dst_state->gamma_lut, src_state->gamma_lut);
+	if (changed || src_state->color_mgmt_changed)
+		dst_state->color_mgmt_changed = true;
+
+	to_dm_crtc_state(dst_state)->regamma_tf = to_dm_crtc_state(src_state)->regamma_tf;
+
+	return 0;
+}
+
+static bool imac5k_cursor_only_commit(struct drm_atomic_commit *state)
+{
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_plane_state *plane_state;
+	struct drm_connector *connector;
+	struct drm_crtc *crtc;
+	struct drm_plane *plane;
+	bool cursor = false;
+	int i;
+
+	for_each_new_connector_in_state(state, connector, conn_state, i)
+		return false;
+
+	for_each_new_crtc_in_state(state, crtc, crtc_state, i) {
+		if (drm_atomic_crtc_needs_modeset(crtc_state) ||
+		    crtc_state->color_mgmt_changed)
+			return false;
+	}
+
+	for_each_new_plane_in_state(state, plane, plane_state, i) {
+		if (plane->type != DRM_PLANE_TYPE_CURSOR)
+			return false;
+		cursor = true;
+	}
+
+	return cursor;
+}
+
+static int imac5k_expand_state(struct drm_device *dev,
+			       struct drm_atomic_commit *state)
+{
+	struct amdgpu_display_manager *dm = &drm_to_adev(dev)->dm;
+	struct drm_crtc *comp = imac5k_companion_crtc(dm);
+	struct drm_connector_state *left_state, *right_state;
+	struct drm_crtc_state *crtc_state, *comp_state;
+	struct drm_plane_state *plane_state, *comp_plane_state;
+	struct drm_crtc *crtc;
+	struct drm_plane *plane;
+	int ret;
+
+	if (!comp || imac5k_cursor_only_commit(state))
+		return 0;
+
+	left_state = drm_atomic_get_connector_state(state, &dm->imac5k_conn[0]->base);
+	if (IS_ERR(left_state))
+		return PTR_ERR(left_state);
+
+	right_state = drm_atomic_get_connector_state(state, &dm->imac5k_conn[1]->base);
+	if (IS_ERR(right_state))
+		return PTR_ERR(right_state);
+
+	crtc = left_state->crtc;
+	if (!crtc)
+		return imac5k_disable_companion(state, comp, right_state);
+
+	crtc_state = drm_atomic_get_crtc_state(state, crtc);
+	if (IS_ERR(crtc_state))
+		return PTR_ERR(crtc_state);
+
+	if (!crtc_state->enable)
+		return imac5k_disable_companion(state, comp, right_state);
+
+	if (!imac5k_mode_halvable(&crtc_state->mode)) {
+		drm_dbg_atomic(dev, "iMac 5K: mode " DRM_MODE_FMT " cannot be split\n",
+			       DRM_MODE_ARG(&crtc_state->mode));
+		return -EINVAL;
+	}
+
+	drm_for_each_plane(plane, dev) {
+		if (plane->type != DRM_PLANE_TYPE_OVERLAY)
+			continue;
+
+		plane_state = drm_atomic_get_new_plane_state(state, plane);
+		if (!plane_state || !plane_state->crtc)
+			continue;
+
+		if (plane_state->crtc == crtc && plane_state->fb) {
+			drm_dbg_atomic(dev, "iMac 5K: overlay planes are not supported\n");
+			return -EINVAL;
+		}
+
+		if (plane_state->crtc == comp) {
+			ret = imac5k_disable_plane(state, plane);
+			if (ret)
+				return ret;
+		}
+	}
+
+	ret = drm_atomic_set_crtc_for_connector(right_state, comp);
+	if (ret)
+		return ret;
+
+	comp_state = drm_atomic_get_crtc_state(state, comp);
+	if (IS_ERR(comp_state))
+		return PTR_ERR(comp_state);
+
+	ret = imac5k_mirror_crtc(comp_state, crtc_state);
+	if (ret)
+		return ret;
+
+	plane_state = drm_atomic_get_plane_state(state, crtc->primary);
+	if (IS_ERR(plane_state))
+		return PTR_ERR(plane_state);
+
+	comp_plane_state = drm_atomic_get_plane_state(state, comp->primary);
+	if (IS_ERR(comp_plane_state))
+		return PTR_ERR(comp_plane_state);
+
+	ret = imac5k_copy_plane_state(comp_plane_state, plane_state, comp);
+	if (ret)
+		return ret;
+
+	return imac5k_disable_plane(state, comp->cursor);
+}
+
+void amdgpu_dm_imac5k_update_companion_cursor(struct drm_plane *plane,
+					      struct drm_plane_state *old_plane_state)
+{
+	struct amdgpu_device *adev = drm_to_adev(plane->dev);
+	struct amdgpu_display_manager *dm = &adev->dm;
+	struct amdgpu_framebuffer *afb = to_amdgpu_framebuffer(plane->state->fb);
+	struct drm_crtc *crtc = afb ? plane->state->crtc : old_plane_state->crtc;
+	struct drm_crtc *comp = imac5k_companion_crtc(dm);
+	struct dm_crtc_state *comp_state;
+	struct amdgpu_crtc *acomp;
+	struct dc_cursor_position position = {0};
+	struct dc_cursor_attributes attributes;
+
+	if (!comp || !amdgpu_dm_imac5k_crtc_is_left(dm, crtc))
+		return;
+
+	if (!plane->state->fb && !old_plane_state->fb)
+		return;
+
+	comp_state = to_dm_crtc_state(comp->state);
+	if (!comp_state->stream)
+		return;
+
+	acomp = to_amdgpu_crtc(comp);
+
+	if (amdgpu_dm_plane_get_cursor_position(plane, comp, &position))
+		return;
+
+	if (!position.enable) {
+		if (!comp_state->stream->cursor_position.enable)
+			return;
+
+		mutex_lock(&dm->dc_lock);
+		dc_stream_program_cursor_position(comp_state->stream, &position);
+		mutex_unlock(&dm->dc_lock);
+		return;
+	}
+
+	memset(&attributes, 0, sizeof(attributes));
+	attributes.address.high_part = upper_32_bits(afb->address);
+	attributes.address.low_part = lower_32_bits(afb->address);
+	attributes.width = plane->state->crtc_w;
+	attributes.height = plane->state->crtc_h;
+	attributes.color_format = CURSOR_MODE_COLOR_PRE_MULTIPLIED_ALPHA;
+	attributes.rotation_angle = 0;
+	attributes.attribute_flags.value = 0;
+	attributes.pitch = afb->base.pitches[0] / afb->base.format->cpp[0];
+

From e35192cc11075c3cbb732c2bcfb5e53871bae7b9 Mon Sep 17 00:00:00 2001
From: Atharva Tiwari <atharvatiwarilinuxdev@gmail.com>
Date: Sun, 18 Oct 2026 19:59:55 -0400
Subject: [PATCH 14/15] mfd/macsmc: add ioctl to access smc keys

Add a /dev/smc device so userspace can talk to the SMC
directly. Some keys that need to be written aren't handled by
any driver, or affect several drivers at once, so they
can't be exposed cleanly through the kernel interfaces.

Keys already managed by kernel drivers can't be written this
way, to avoid conflicts.

Signed-off-by: Atharva Tiwari <atharvatiwarilinuxdev@gmail.com>
---
 drivers/mfd/macsmc-core.c   | 140 ++++++++++++++++++++++++++++++++++++
 include/linux/mfd/macsmc.h  |  61 ++--------------
 include/uapi/linux/macsmc.h | 119 ++++++++++++++++++++++++++++++
 3 files changed, 264 insertions(+), 56 deletions(-)
 create mode 100644 include/uapi/linux/macsmc.h

diff --git a/drivers/mfd/macsmc-core.c b/drivers/mfd/macsmc-core.c
index bc4200f57..a53df6f6c 100644
--- a/drivers/mfd/macsmc-core.c
+++ b/drivers/mfd/macsmc-core.c
@@ -6,10 +6,13 @@
 
 #include <linux/bitfield.h>
 #include <linux/device.h>
+#include <linux/fs.h>
 #include <linux/mfd/core.h>
 #include <linux/mfd/macsmc.h>
+#include <linux/miscdevice.h>
 #include <linux/mutex.h>
 #include <linux/spinlock.h>
+#include <linux/uaccess.h>
 
 static const struct mfd_cell apple_smc_rtkit_devs[] = {
 	MFD_CELL_NAME("macsmc-input"),
@@ -112,6 +115,129 @@ static void apple_smc_disable_notifications(void *data)
 	smc->be->disable_notifications(smc->be_cookie);
 }
 
+static long apple_smc_fops_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct apple_smc *smc = file->private_data;
+	void __user *argp = (void __user *)arg;
+	int ret;
+
+	switch (cmd) {
+	case IOCTL_SMC_READ: {
+		struct ioctl_smc_rw_payload payload;
+		struct apple_smc_key_info info;
+
+		if (copy_from_user(&payload, argp, sizeof(payload)))
+			return -EFAULT;
+
+		ret = apple_smc_get_key_info(smc, payload.key, &info);
+		if (ret < 0)
+			return ret;
+
+		if (payload.size != info.size)
+			return -EINVAL;
+
+		if (payload.size > 32 || !(info.flags & APPLE_SMC_READABLE))
+			return -EINVAL;
+
+		ret = apple_smc_read(smc, payload.key, payload.buf, payload.size);
+		if (ret < 0)
+			return ret;
+
+		if (copy_to_user(argp, &payload, sizeof(payload)))
+			return -EFAULT;
+		return 0;
+	}
+	case IOCTL_SMC_WRITE: {
+		struct ioctl_smc_rw_payload payload;
+		struct apple_smc_key_info info;
+
+		if (copy_from_user(&payload, argp, sizeof(payload)))
+			return -EFAULT;
+
+		ret = apple_smc_get_key_info(smc, payload.key, &info);
+		if (ret < 0)
+			return ret;
+
+		if (payload.size != info.size)
+			return -EINVAL;
+
+		if (payload.size > 32)
+			return -EINVAL;
+
+		switch (payload.key) {
+		case __SMC_KEY('H', 'E', '0', 'N'):
+		case __SMC_KEY('H', 'E', '2', 'N'):
+		case __SMC_KEY('H', 'I', '0', 'N'):
+		case __SMC_KEY('M', 'S', 'T', 'S'):
+		case __SMC_KEY('M', 'S', 'P', 'C'):
+		case __SMC_KEY('Q', 'E', 'N', 'A'):
+			break;
+		default:
+			return -EPERM;
+		}
+
+		ret = apple_smc_write(smc, payload.key, payload.buf, payload.size);
+		if (ret < 0)
+			return ret;
+
+		return 0;
+	}
+	case IOCTL_SMC_GET_KEY_INDEX: {
+		struct ioctl_smc_index_payload payload;
+
+		if (copy_from_user(&payload, argp, sizeof(payload)))
+			return -EFAULT;
+
+		ret = apple_smc_get_key_by_index(smc, payload.index, &payload.key);
+		if (ret < 0)
+			return ret;
+
+		if (copy_to_user(argp, &payload, sizeof(payload)))
+			return -EFAULT;
+
+		return 0;
+	}
+	case IOCTL_SMC_GET_KEY_INFO: {
+		struct ioctl_smc_info_payload payload;
+
+		if (copy_from_user(&payload, argp, sizeof(payload)))
+			return -EFAULT;
+
+		ret = apple_smc_get_key_info(smc, payload.key, &payload.info);
+		if (ret < 0)
+			return ret;
+
+		if (copy_to_user(argp, &payload, sizeof(payload)))
+			return -EFAULT;
+
+		return 0;
+	}
+	default:
+		return -EINVAL;
+	}
+}
+
+static int apple_smc_fops_open(struct inode *inode, struct file *file)
+{
+	struct miscdevice *misc = file->private_data;
+
+	file->private_data = container_of(misc, struct apple_smc, miscdev);
+	return 0;
+}
+
+static const struct file_operations apple_smc_fops = {
+	.owner		= THIS_MODULE,
+	.open		= apple_smc_fops_open,
+	.unlocked_ioctl	= apple_smc_fops_ioctl,
+	.compat_ioctl	= compat_ptr_ioctl,
+	.llseek		= noop_llseek,
+};
+
+static void apple_smc_misc_unregister(void *data)
+{
+	misc_deregister(data);
+}
+
 int apple_smc_probe(struct device *dev, const struct apple_smc_backend_ops *ops,
 		void *cookie, struct blocking_notifier_head *event_handlers, bool is_acpi)
 {
@@ -150,6 +276,20 @@ int apple_smc_probe(struct device *dev, const struct apple_smc_backend_ops *ops,
 	if (ret)
 		return ret;
 
+	smc->miscdev.minor = MISC_DYNAMIC_MINOR;
+	smc->miscdev.name = "smc";
+	smc->miscdev.fops = &apple_smc_fops;
+	smc->miscdev.parent = dev;
+	smc->miscdev.mode = 0600;
+
+	ret = misc_register(&smc->miscdev);
+	if (ret)
+		return ret;
+
+	ret = devm_add_action_or_reset(dev, apple_smc_misc_unregister, &smc->miscdev);
+	if (ret)
+		return ret;
+
 	if (smc->is_acpi) {
 		ret = devm_mfd_add_devices(dev, -1, apple_smc_acpi_common,
 			ARRAY_SIZE(apple_smc_acpi_common), NULL, 0, NULL);
diff --git a/include/linux/mfd/macsmc.h b/include/linux/mfd/macsmc.h
index cdd040f0c..a09dc6396 100644
--- a/include/linux/mfd/macsmc.h
+++ b/include/linux/mfd/macsmc.h
@@ -8,44 +8,9 @@
 #ifndef _LINUX_MFD_MACSMC_H
 #define _LINUX_MFD_MACSMC_H
 
+#include <linux/miscdevice.h>
 #include <linux/soc/apple/rtkit.h>
-
-/**
- * typedef smc_key - Alias for u32 to be used for SMC keys
- *
- * SMC keys are 32bit integers containing packed ASCII characters in natural
- * integer order, i.e. 0xAABBCCDD, which represent the FourCC ABCD.
- * The SMC driver is designed with this assumption and ensures the right
- * endianness is used when these are stored to memory and sent to or received
- * from the actual SMC firmware (which can be done in either shared memory or
- * as 64bit mailbox message on Apple Silicon).
- * Internally, SMC stores these keys in a table sorted lexicographically and
- * allows resolving an index into this table to the corresponding SMC key.
- * Thus, storing keys as u32 is very convenient as it allows to e.g. use
- * normal comparison operators which directly map to the natural order used
- * by SMC firmware.
- *
- * This simple type alias is introduced to allow easy recognition of SMC key
- * variables and arguments.
- */
-typedef u32 smc_key;
-
-/**
- * SMC_KEY - Convert FourCC SMC keys in source code to smc_key
- *
- * This macro can be used to easily define FourCC SMC keys in source code
- * and convert these to u32 / smc_key, e.g. SMC_KEY(NTAP) will expand to
- * 0x4e544150.
- *
- * @s: FourCC SMC key to be converted
- */
-#define SMC_KEY(s) (smc_key)(_SMC_KEY(#s))
-#define _SMC_KEY(s) (((s)[0] << 24) | ((s)[1] << 16) | ((s)[2] << 8) | (s)[3])
-#define __SMC_KEY(a, b, c, d) (((u32)(a) << 24) | ((u32)(b) << 16) | ((u32)(c) << 8) | ((u32)(d)))
-
-#define APPLE_SMC_READABLE BIT(7)
-#define APPLE_SMC_WRITABLE BIT(6)
-#define APPLE_SMC_FUNCTION BIT(4)
+#include <uapi/linux/macsmc.h>
 
 #define SMC_MSG_READ_KEY                0x10
 #define SMC_MSG_WRITE_KEY               0x11
@@ -66,25 +31,6 @@ typedef u32 smc_key;
 #define SMC_INT_SMS_SHOCK               0x6F
 #define SMC_INT_PLIMIT_CHANGED          0x80
 
-/**
- * struct apple_smc_key_info - Information for a SMC key as returned by SMC
- * @type_code: FourCC code indicating the type for this key.
- *             Known types:
- *              ch8*: ASCII string
- *              flag: Boolean, 1 or 0
- *              flt: 32-bit single-precision IEEE 754 float
- *              hex: Binary data
- *              ioft: 64bit Unsigned fixed-point intger (48.16)
- *              {si,ui}{8,16,32,64}: Signed/Unsigned 8-/16-/32-/64-bit integer
- * @size: Size of the buffer associated with this key
- * @flags: Bitfield encoding flags (APPLE_SMC_{READABLE,WRITABLE,FUNCTION})
- */
-struct apple_smc_key_info {
-	u32 type_code;
-	u8 size;
-	u8 flags;
-};
-
 /**
  * enum apple_smc_boot_stage - SMC boot stage
  * @APPLE_SMC_BOOTING: SMC is booting
@@ -136,6 +82,7 @@ struct apple_smc_backend_ops {
  * @is_acpi: Is the backend ACPI based
  * @mutex: Mutex for non-atomic mode
  * @lock: Spinlock for atomic mode
+ * @miscdev: Misc Device struct for ioctl ops
  */
 struct apple_smc {
 	struct device *dev;
@@ -152,6 +99,8 @@ struct apple_smc {
 
 	struct mutex mutex;
 	spinlock_t lock;
+
+	struct miscdevice miscdev;
 };
 
 /**
diff --git a/include/uapi/linux/macsmc.h b/include/uapi/linux/macsmc.h
new file mode 100644
index 000000000..ef784539d
--- /dev/null
+++ b/include/uapi/linux/macsmc.h
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT WITH Linux-syscall-note */
+/*
+ * Apple SMC Public Interface
+ *
+ * Copyright (C) 2026 Atharva Tiwari <atharvatiwarilinuxdev@gmail.com>
+ */
+
+#ifndef _UAPI_MACSMC_H
+#define _UAPI_MACSMC_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+/**
+ * typedef smc_key - Alias for u32 to be used for SMC keys
+ *
+ * SMC keys are 32bit integers containing packed ASCII characters in natural
+ * integer order, i.e. 0xAABBCCDD, which represent the FourCC ABCD.
+ * The SMC driver is designed with this assumption and ensures the right
+ * endianness is used when these are stored to memory and sent to or received
+ * from the actual SMC firmware (which can be done in either shared memory or
+ * as 64bit mailbox message on Apple Silicon).
+ * Internally, SMC stores these keys in a table sorted lexicographically and
+ * allows resolving an index into this table to the corresponding SMC key.
+ * Thus, storing keys as u32 is very convenient as it allows to e.g. use
+ * normal comparison operators which directly map to the natural order used
+ * by SMC firmware.
+ *
+ * This simple type alias is introduced to allow easy recognition of SMC key
+ * variables and arguments.
+ */
+typedef __u32 smc_key;
+
+/**
+ * SMC_KEY - Convert FourCC SMC keys in source code to smc_key
+ *
+ * This macro can be used to easily define FourCC SMC keys in source code
+ * and convert these to u32 / smc_key, e.g. SMC_KEY(NTAP) will expand to
+ * 0x4e544150.
+ *
+ * @s: FourCC SMC key to be converted
+ */
+#define SMC_KEY(s) ((smc_key)(_SMC_KEY(#s)))
+#define _SMC_KEY(s) (((s)[0] << 24) | ((s)[1] << 16) | ((s)[2] << 8) | (s)[3])
+#define __SMC_KEY(a, b, c, d) (((__u32)(a) << 24) | ((__u32)(b) << 16) | ((__u32)(c) << 8) | ((__u32)(d)))
+
+#define APPLE_SMC_READABLE		BIT(7)
+#define APPLE_SMC_WRITABLE		BIT(6)
+#define APPLE_SMC_FUNCTION		BIT(4)
+#define APPLE_SMC_CONST		BIT(3)
+#define APPLE_SMC_ATOMIC		BIT(2)
+#define APPLE_SMC_PRIVATE_READ		BIT(1)
+#define APPLE_SMC_PRIVATE_WRITE		BIT(0)
+
+/**
+ * struct apple_smc_key_info - Information for a SMC key as returned by SMC
+ * @type_code: FourCC code indicating the type for this key.
+ *      Known types:
+ *       ch8*: ASCII string
+ *       flag: Boolean, 1 or 0
+ *       flt: 32-bit single-precision IEEE 754 float
+ *       hex: Binary data
+ *       ioft: 64bit Unsigned fixed-point intger (48.16)
+ *       {si,ui}{8,16,32,64}: Signed/Unsigned 8-/16-/32-/64-bit integer
+ * @size: Size of the buffer associated with this key
+ * @flags: Bitfield encoding flags (APPLE_SMC_{READABLE,WRITABLE,FUNCTION,
+ *       CONST,ATOMIC,PRIVATE_READ,PRIVATE_WRITE})
+ */
+struct apple_smc_key_info {
+	__u32 type_code;
+	__u8 size;
+	__u8 flags;
+};
+
+/**
+ * struct ioctl_smc_rw_payload - argument for IOCTL_SMC_READ and IOCTL_SMC_WRITE
+ * @key: SMC key to access. Input.
+ * @size: Size of the key's data in bytes. Input. It must match the size the
+ *	SMC reports for @key (see IOCTL_SMC_GET_KEY_INFO) and cannot exceed
+ *	the size of @buf.
+ * @buf: Key data. For IOCTL_SMC_READ this is filled in by the kernel with the
+ *	value read from @key. For IOCTL_SMC_WRITE it holds the value to write to
+ *	@key.
+ */
+struct ioctl_smc_rw_payload {
+	smc_key key;
+	__u32 size;
+	__u8 buf[32];
+};
+
+/**
+ * struct ioctl_smc_index_payload - argument for IOCTL_SMC_GET_KEY_INDEX
+ * @index: Position in the SMC's key table. Input.
+ * @key: Key stored at @index. Filled in by the kernel.
+ *
+ * Calling this with increasing @index values lists every key the SMC exposes.
+ */
+struct ioctl_smc_index_payload {
+	__u16 index;
+	smc_key key;
+};
+
+/**
+ * struct ioctl_smc_info_payload - argument for IOCTL_SMC_GET_KEY_INFO
+ * @key: SMC key to look up. Input.
+ * @info: Size, type code and flags of @key. Filled in by the kernel.
+ */
+struct ioctl_smc_info_payload {
+	smc_key key;
+	struct apple_smc_key_info info;
+};
+
+#define APPLE_SMC_MAGIC 'S'
+#define IOCTL_SMC_READ    _IOWR(APPLE_SMC_MAGIC, 1, struct ioctl_smc_rw_payload)
+#define IOCTL_SMC_WRITE   _IOW(APPLE_SMC_MAGIC, 2, struct ioctl_smc_rw_payload)
+#define IOCTL_SMC_GET_KEY_INDEX  _IOWR(APPLE_SMC_MAGIC, 3, struct ioctl_smc_index_payload)
+#define IOCTL_SMC_GET_KEY_INFO   _IOWR(APPLE_SMC_MAGIC, 4, struct ioctl_smc_info_payload)
+
+#endif /* _UAPI_MACSMC_H */
-- 
